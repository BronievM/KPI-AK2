# Object and executable files
*.o
*.a
*.out
*.exe

# Compiled output directories
**/MakeCompiled/
**/Ninja/

# Temporary CMake files (ignore completely)
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake

# Temporary Ninja files
**/.ninja_deps
**/.ninja_log

# Temporary Word files
~$*.docx

# Linux kernel module files
*.ko
*.mod
*.mod.c
*.mod.o
modules.order
Module.symvers

# Hidden Kbuild command files
.*.cmd

# Temporary Kbuild build directories
.tmp_versions/